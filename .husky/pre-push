#!/bin/sh
. "$(dirname "$0")/_/husky.sh" || exit 1

protected_ref=refs/heads/main

only_zeros() {
  case "$1" in
    *[!0]*) return 1 ;;
  esac
  return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected_ref" ]; then
    echo "Push to main refused: main changes only through a pull request. Push a feature branch and open one with gh pr create."
    exit 1
  fi
  if only_zeros "$local_sha" || only_zeros "$remote_sha"; then
    continue
  fi
  if ! git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
    echo "Push refused: $remote_ref has commits this clone does not have. Run git fetch, merge them, then push."
    exit 1
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "Force push refused: $remote_ref would lose commits that are already pushed. Merge instead of rewriting a pushed branch."
    exit 1
  fi
done
exit 0
